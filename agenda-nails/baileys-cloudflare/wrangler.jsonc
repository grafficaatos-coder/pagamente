{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "agenda-pro-baileys",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-05",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": true,
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1
  },
  "vars": {
    "AGENDA_ORIGIN": "https://agenda-nails-grafficaatos-3591.vercel.app"
  },
  "r2_buckets": [
    {
      "binding": "WHATSAPP_PROFILES",
      "bucket_name": "agenda-pro-whatsapp-sessions"
    }
  ],
  "containers": [
    {
      "class_name": "WhatsAppContainer",
      "image": "./Dockerfile",
      "max_instances": 20,
      "rollout_step_percentage": 100,
      "instance_type": "basic",
      "constraints": {
        "regions": ["SAM"]
      }
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "name": "WHATSAPP_CONTAINER",
        "class_name": "WhatsAppContainer"
      }
    ]
  },
  "exports": {
    "WhatsAppContainer": {
      "type": "durable-object",
      "storage": "sqlite"
    }
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["WhatsAppContainer"]
    }
  ],
  "triggers": {
    "crons": ["* * * * *"]
  }
}
